*.html
!piquesignal/**/*.html
gen/*.css
gen/engine_parts.js
gen/tests/make_expected.py
gen/_*
# Python / local leftovers
__pycache__/
*.pyc
*.pyo
.venv*/
node_modules/
.pytest_cache/
